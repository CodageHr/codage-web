# ---------------------------------------------------------------------------
# Codage frontend environment. Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# All NEXT_PUBLIC_* variables are exposed to the browser — do not put secrets here.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_NAME=Codage
NEXT_APP_HOST="https://codage.hr"

# Backend API (Laravel — lives in a SEPARATE repository).
#  - Production:        https://api.codage.hr
#  - Local (host):      http://localhost:8080  (or your Laravel .test vhost)
#  - Local (docker net): http://<backend-service>:<port>  (see docker-compose.yml)
NEXT_PUBLIC_BACKEND_HOST_API=https://api.codage.hr

# Minimal UI template demo API (used by some template components/mocks)
NEXT_PUBLIC_HOST_API=https://api-dev-minimal-v510.vercel.app
NEXT_PUBLIC_ASSETS_API=https://api-dev-minimal-v510.vercel.app

# Mapbox (contact map). Get a token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_API=

# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=

# Google reCAPTCHA v3 — SITE key (public). Register at https://www.google.com/recaptcha/admin/create
# Pick reCAPTCHA v3, add domains codage.hr (+ localhost for dev). The SECRET key goes in the
# backend repo (RECAPTCHA_SECRET). Leave blank to disable captcha locally (form still works).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Docker (docker-compose.yml)
# ---------------------------------------------------------------------------
# Host port the Next.js dev server is published on (container always uses 8082).
APP_FRONT_PORT=8082
