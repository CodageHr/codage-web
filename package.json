{
  "name": "@codage-web/nextjs",
  "author": "Codage",
  "version": "1.0.0",
  "description": "Next & TypeScript",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 8082",
    "start": "next start -p 8082",
    "build": "next build",
    "lint": "eslint --no-error-on-unmatched-pattern --quiet \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --no-error-on-unmatched-pattern --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "rm:all": "rm -rf node_modules .next out dist build",
    "re:start": "npm run rm:all && npm install && npm run dev",
    "re:build": "npm run rm:all && npm install && npm run build",
    "dev:ts": "npm run dev & npm run ts:watch",
    "ts": "tsc --noEmit --incremental",
    "ts:watch": "npm run ts -- --watch"
  },
  "pre-commit": [
    "lint"
  ],
  "dependencies": {
    "@emotion/cache": "^11.14.0",
