    "framer-motion": "^12.23.25",
    "highlight.js": "^11.10.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.9.0",
    "next": "^16.2.9",
